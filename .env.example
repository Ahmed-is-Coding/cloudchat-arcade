# ----- App -----
APP_NAME="CloudChat Arcade"
ENVIRONMENT="dev"
CORS_ORIGINS="http://localhost:3000"

# JWT
JWT_SECRET="CHANGE_ME__dev_only"
JWT_ALG="HS256"
JWT_EXPIRE_MINUTES=720

# ----- Postgres -----
POSTGRES_USER="cloudchat"
POSTGRES_PASSWORD="cloudchat"
POSTGRES_DB="cloudchat"
DATABASE_URL="postgresql+asyncpg://cloudchat:cloudchat@postgres:5432/cloudchat"

# ----- Redis -----
REDIS_URL="redis://redis:6379/0"

# ----- Jitsi (MVP embed) -----
JITSI_BASE_URL="https://meet.jit.si"
